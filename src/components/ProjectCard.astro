---
interface Props {
  title: string;
  description: string;
  technologies: string[];
  externalUrl?: string;
  pubDate?: Date;
}

const { title, description, technologies, externalUrl } = Astro.props;
---

<div class="flex flex-col bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-200">
  <div class="flex items-center justify-between gap-2 mb-3">
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
      Ar-Ge Project
    </span>
    {externalUrl && (
      <a
        href={externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-400 hover:text-brand-accent transition-colors"
        title="External Link"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    )}
  </div>

  <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
    {title}
  </h3>

  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4 flex-1">
    {description}
  </p>

  <div class="mt-auto">
    <div class="flex flex-wrap gap-1.5 pt-3 border-t border-slate-100 dark:border-slate-700/40">
      {technologies.map((tech) => (
        <span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono bg-slate-50 dark:bg-slate-900/60 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700">
          {tech}
        </span>
      ))}
    </div>
  </div>
</div>
