---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<a
  href={shareUrl}
  target="_blank"
  rel="noopener noreferrer"
  title={`LinkedIn'de Paylaş: ${title}`}
  class="inline-flex items-center gap-2 px-4 py-2 bg-[#0a66c2] hover:bg-[#084e96] text-white text-xs sm:text-sm font-semibold rounded-lg shadow-sm transition-all duration-200"
>
  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/>
  </svg>
  <span>LinkedIn'de Paylaş</span>
</a>
