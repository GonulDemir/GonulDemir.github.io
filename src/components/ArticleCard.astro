---
import { useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: string;
  subcategory?: string;
  readingTime?: number;
}

const { title, description, pubDate, slug, category, subcategory, readingTime = 5 } = Astro.props;

const t = useTranslations('en');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(pubDate);

const cleanSlug = slug.replace(/^(tr|en)\//, '');
const articleUrl = `/articles/${cleanSlug}`;
const categoryKey = `cat.${category}` as any;
const categoryLabel = t(categoryKey) || category;
---

<article
  class="group relative flex flex-col bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-brand-accent/50 dark:hover:border-brand-accent/50 transition-all duration-200"
  data-category={category}
  data-subcategory={subcategory || ''}
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
>
  <div class="flex items-center gap-2 text-xs mb-3 flex-wrap">
    <!-- Category Badge -->
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-brand-accent dark:text-blue-300 border border-blue-200/50 dark:border-blue-800/50">
      {categoryLabel}
    </span>
    {subcategory && (
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 dark:bg-slate-700/60 text-slate-600 dark:text-slate-300">
        {subcategory}
      </span>
    )}
    <span class="text-slate-300 dark:text-slate-600 ml-auto">•</span>
    <time datetime={pubDate.toISOString()} class="text-xs text-slate-500 dark:text-slate-400">
      {formattedDate}
    </time>
  </div>

  <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-brand-accent dark:group-hover:text-blue-400 transition-colors mb-2 line-clamp-2">
    <a href={articleUrl} class="focus:outline-none">
      <span class="absolute inset-0" aria-hidden="true"></span>
      {title}
    </a>
  </h3>

  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4 line-clamp-3">
    {description}
  </p>

  <div class="mt-auto flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-700/40 text-xs text-slate-500 dark:text-slate-400">
    <span class="flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      {readingTime} {t('articles.readTime')}
    </span>

    <span class="inline-flex items-center font-medium text-brand-accent dark:text-blue-400 group-hover:translate-x-1 transition-transform">
      Read
      <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </span>
  </div>
</article>
