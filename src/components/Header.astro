---
import { useTranslations } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';

const t = useTranslations('en');

const homePath = '/';
const aboutPath = '/about';
const articlesPath = '/articles';
const projectsPath = '/projects';
const freezonePath = '/free-zone';
const contactPath = '/contact';

const categories = [
  { slug: 'optical-sensing-system-design', key: 'cat.optical-sensing-system-design' },
  { slug: 'electromagnetic-compatibility', key: 'cat.electromagnetic-compatibility' },
  { slug: 'analog-design-power-electronics', key: 'cat.analog-design-power-electronics' },
  { slug: 'astronomy-astrophysics-space-science', key: 'cat.astronomy-astrophysics-space-science' },
  { slug: 'product-verification-certification', key: 'cat.product-verification-certification' },
  { slug: 'bio-inspired-sensors-robotics', key: 'cat.bio-inspired-sensors-robotics' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo & Title -->
      <div class="flex flex-col justify-center">
        <a href={homePath} class="group flex items-baseline gap-2">
          <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-brand-accent transition-colors">
            Gönül Demir
          </span>
          <span class="inline-block w-2 h-2 rounded-full bg-brand-accent"></span>
        </a>
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 tracking-wide mt-0.5">
          {t('hero.subtitle')}
        </span>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-sm font-medium">
        <a
          href={homePath}
          class={`px-3 py-2 rounded-md transition-colors ${
            currentPath === '/' || currentPath === ''
              ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
              : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
          }`}
        >
          {t('nav.home')}
        </a>

        <a
          href={aboutPath}
          class={`px-3 py-2 rounded-md transition-colors ${
            currentPath.startsWith('/about')
              ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
              : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
          }`}
        >
          {t('nav.about')}
        </a>

        <!-- Articles with Dropdown -->
        <div class="relative group">
          <a
            href={articlesPath}
            class={`inline-flex items-center gap-1 px-3 py-2 rounded-md transition-colors ${
              currentPath.startsWith('/articles')
                ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
                : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
            }`}
          >
            <span>{t('nav.articles')}</span>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-brand-accent transition-transform group-hover:rotate-180 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>

          <!-- Dropdown Panel -->
          <div class="absolute left-0 top-full pt-2 w-96 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 z-50">
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl p-3 space-y-1">
              {categories.map((cat) => (
                <a
                  href={`${articlesPath}?category=${cat.slug}`}
                  class="block px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 rounded-lg transition-colors"
                >
                  {t(cat.key as any)}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a
          href={projectsPath}
          class={`px-3 py-2 rounded-md transition-colors ${
            currentPath.startsWith('/projects')
              ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
              : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
          }`}
        >
          {t('nav.projects')}
        </a>

        <!-- Free Zone Independent Link -->
        <a
          href={freezonePath}
          class={`px-3 py-2 rounded-md transition-colors ${
            currentPath.startsWith('/free-zone')
              ? 'text-amber-500 font-semibold bg-amber-50 dark:bg-amber-950/40'
              : 'text-amber-600 dark:text-amber-400 hover:text-amber-500 dark:hover:text-amber-300 hover:bg-amber-50/50 dark:hover:bg-amber-950/30'
          }`}
        >
          {t('nav.freezone')}
        </a>

        <a
          href={contactPath}
          class={`px-3 py-2 rounded-md transition-colors ${
            currentPath.startsWith('/contact')
              ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
              : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
          }`}
        >
          {t('nav.contact')}
        </a>
      </nav>

      <!-- Action Controls (Dark Mode) -->
      <div class="flex items-center gap-3">
        <ThemeToggle />
        
        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden p-2 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white focus:outline-none"
          aria-label="Toggle mobile menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 pt-3 pb-6 space-y-2">
    <a href={homePath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.home')}
    </a>
    <a href={aboutPath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.about')}
    </a>
    <a href={articlesPath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.articles')}
    </a>
    <a href={projectsPath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.projects')}
    </a>
    <a href={freezonePath} class="block px-3 py-2 rounded-md text-base font-medium text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/40">
      {t('nav.freezone')}
    </a>
    <a href={contactPath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.contact')}
    </a>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.onclick = () => {
        menu.classList.toggle('hidden');
      };
    }
  }
  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
