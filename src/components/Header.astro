---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homePath = `/${lang}/`;
const aboutPath = lang === 'tr' ? `/${lang}/hakkimda` : `/${lang}/about`;
const articlesPath = lang === 'tr' ? `/${lang}/makaleler` : `/${lang}/articles`;
const projectsPath = lang === 'tr' ? `/${lang}/projeler` : `/${lang}/projects`;
const contactPath = lang === 'tr' ? `/${lang}/iletisim` : `/${lang}/contact`;

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo & Title -->
      <div class="flex flex-col justify-center">
        <a href={homePath} class="group flex items-baseline gap-2">
          <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-brand-accent transition-colors">
            Gönül Demir
          </span>
          <span class="inline-block w-2 h-2 rounded-full bg-brand-accent"></span>
        </a>
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 tracking-wide mt-0.5">
          {t('hero.subtitle')}
        </span>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-sm font-medium">
        <a
          href={homePath}
          class={`px-3 py-2 rounded-md transition-colors ${
            currentPath === homePath || currentPath === `${homePath}`
              ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
              : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
          }`}
        >
          {t('nav.home')}
        </a>

        <a
          href={aboutPath}
          class={`px-3 py-2 rounded-md transition-colors ${
            currentPath.includes('hakkimda') || currentPath.includes('about')
              ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
              : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
          }`}
        >
          {t('nav.about')}
        </a>

        <!-- Articles with Dropdown -->
        <div class="relative group">
          <a
            href={articlesPath}
            class={`inline-flex items-center gap-1 px-3 py-2 rounded-md transition-colors ${
              currentPath.includes('makaleler') || currentPath.includes('articles')
                ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
                : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
            }`}
          >
            <span>{t('nav.articles')}</span>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-brand-accent transition-transform group-hover:rotate-180 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>

          <!-- Dropdown Panel -->
          <div class="absolute left-0 top-full pt-2 w-80 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 z-50">
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl p-4 space-y-4">
              <!-- Optoelectronics Category -->
              <div>
                <a
                  href={`${articlesPath}?category=optoelectronics-optics`}
                  class="block font-semibold text-xs text-brand-accent dark:text-blue-400 uppercase tracking-wider mb-1.5 hover:underline"
                >
                  {t('cat.optoelectronics-optics')}
                </a>
                <div class="space-y-1 pl-2 border-l-2 border-slate-200 dark:border-slate-800">
                  <a href={`${articlesPath}?subcategory=optical-system-design`} class="block text-xs text-slate-600 dark:text-slate-400 hover:text-brand-accent dark:hover:text-white py-0.5">
                    {t('subcat.optical-system-design')}
                  </a>
                  <a href={`${articlesPath}?subcategory=astronomy-space`} class="block text-xs text-slate-600 dark:text-slate-400 hover:text-brand-accent dark:hover:text-white py-0.5">
                    {t('subcat.astronomy-space')}
                  </a>
                  <a href={`${articlesPath}?subcategory=sensor-applications`} class="block text-xs text-slate-600 dark:text-slate-400 hover:text-brand-accent dark:hover:text-white py-0.5">
                    {t('subcat.sensor-applications')}
                  </a>
                </div>
              </div>

              <!-- EMC Category -->
              <div>
                <a
                  href={`${articlesPath}?category=emc-noise-management`}
                  class="block font-semibold text-xs text-brand-accent dark:text-blue-400 uppercase tracking-wider mb-1.5 hover:underline"
                >
                  {t('cat.emc-noise-management')}
                </a>
                <div class="space-y-1 pl-2 border-l-2 border-slate-200 dark:border-slate-800">
                  <a href={`${articlesPath}?subcategory=pcb-design-shielding`} class="block text-xs text-slate-600 dark:text-slate-400 hover:text-brand-accent dark:hover:text-white py-0.5">
                    {t('subcat.pcb-design-shielding')}
                  </a>
                  <a href={`${articlesPath}?subcategory=grounding-cabling`} class="block text-xs text-slate-600 dark:text-slate-400 hover:text-brand-accent dark:hover:text-white py-0.5">
                    {t('subcat.grounding-cabling')}
                  </a>
                  <a href={`${articlesPath}?subcategory=robotics-emc`} class="block text-xs text-slate-600 dark:text-slate-400 hover:text-brand-accent dark:hover:text-white py-0.5">
                    {t('subcat.robotics-emc')}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <a
          href={projectsPath}
          class={`px-3 py-2 rounded-md transition-colors ${
            currentPath.includes('projeler') || currentPath.includes('projects')
              ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
              : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
          }`}
        >
          {t('nav.projects')}
        </a>

        <a
          href={contactPath}
          class={`px-3 py-2 rounded-md transition-colors ${
            currentPath.includes('iletisim') || currentPath.includes('contact')
              ? 'text-brand-accent font-semibold bg-slate-100 dark:bg-slate-800'
              : 'text-slate-700 dark:text-slate-300 hover:text-brand-accent dark:hover:text-brand-accent hover:bg-slate-50 dark:hover:bg-slate-800/50'
          }`}
        >
          {t('nav.contact')}
        </a>
      </nav>

      <!-- Action Controls (Language & Dark Mode) -->
      <div class="flex items-center gap-3">
        <LanguagePicker />
        <ThemeToggle />
        
        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden p-2 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white focus:outline-none"
          aria-label="Toggle mobile menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 pt-3 pb-6 space-y-2">
    <a href={homePath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.home')}
    </a>
    <a href={aboutPath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.about')}
    </a>
    <a href={articlesPath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.articles')}
    </a>
    <a href={projectsPath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.projects')}
    </a>
    <a href={contactPath} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {t('nav.contact')}
    </a>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.onclick = () => {
        menu.classList.toggle('hidden');
      };
    }
  }
  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
