---
import BaseLayout from './BaseLayout.astro';
import ShareLinkedIn from '../components/ShareLinkedIn.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { useTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  subcategory?: string;
  readingTime?: number;
  sourceUrl?: string;
  slug: string;
}

const { title, description, pubDate, category, subcategory, readingTime = 5, sourceUrl, slug } = Astro.props;

const t = useTranslations('en');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);

const pageUrl = Astro.url.href;

// Fetch related articles (excluding current)
const allPosts = await getCollection('blog');
const currentCleanSlug = slug.replace(/^(tr|en)\//, '');
const relatedPosts = allPosts
  .filter((post) => post.slug.replace(/^(tr|en)\//, '') !== currentCleanSlug && post.data.category === category)
  .slice(0, 2);

const categoryKey = `cat.${category}` as any;
const categoryLabel = t(categoryKey) || category;
const backPath = '/articles';
---

<BaseLayout title={`${title} | Gönül Demir`} description={description} articleDate={pubDate}>
  <article class="max-w-4xl mx-auto">
    <!-- Back to Articles Link -->
    <a
      href={backPath}
      class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-brand-accent dark:hover:text-blue-400 transition-colors mb-8"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      {t('nav.articles')}
    </a>

    <!-- Article Header Header -->
    <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2 mb-4 flex-wrap">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-brand-accent dark:text-blue-300 border border-blue-200/50 dark:border-blue-800/50">
          {categoryLabel}
        </span>
        {subcategory && (
          <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
            {subcategory}
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
        {description}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-4">
          <time datetime={pubDate.toISOString()}>
            {formattedDate}
          </time>
          <span>•</span>
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            {readingTime} {t('articles.readTime')}
          </span>
        </div>

        <ShareLinkedIn title={title} url={pageUrl} />
      </div>

      {sourceUrl && (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-brand-accent dark:text-blue-400 hover:underline"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14Zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4s1.4.63 1.4 1.4v4.93h2.75ZM6.46 10.9v8.37h2.79V10.9H6.46Zm1.4-4.16a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24Z" />
          </svg>
          Read the original article on LinkedIn
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M11 3a1 1 0 1 0 0 2h2.59L8.3 10.29a1 1 0 1 0 1.42 1.42L15 6.41V9a1 1 0 1 0 2 0V3h-6Z" />
            <path d="M5 5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-3a1 1 0 1 0-2 0v3H5V7h3a1 1 0 1 0 0-2H5Z" />
          </svg>
        </a>
      )}
    </header>

    <!-- Main Content Area -->
    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-brand-accent dark:prose-a:text-blue-400 prose-img:rounded-xl">
      <slot />
    </div>

    <!-- Related Articles Section -->
    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-10 border-t border-slate-200 dark:border-slate-800">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6">
          {t('articles.relatedArticles')}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedPosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.slug}
              category={post.data.category}
              subcategory={post.data.subcategory}
              readingTime={post.data.readingTime}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
