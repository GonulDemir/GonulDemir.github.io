---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KaTeXHead from '../components/KaTeXHead.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  articleDate?: Date;
  articleModifiedDate?: Date;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Gönül Demir | Senior Electronics R&D & Product Engineer",
  description = "Gönül Demir - Senior Electronics R&D Engineer. Hardware Design, Optoelectronics, Sensor Systems, EMC/EMI Noise Management.",
  ogImage = "/og-default.png",
  ogImageAlt = "Gönül Demir — Electronics R&D, sensor systems, optoelectronics and EMC engineering",
  articleDate,
  articleModifiedDate,
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site);
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : '';
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Gönül Demir" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Gönül Demir — Electronics R&D" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    {articleModifiedDate && <meta property="article:modified_time" content={articleModifiedDate.toISOString()} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {serializedStructuredData && (
      <script type="application/ld+json" set:html={serializedStructuredData} />
    )}

    <!-- KaTeX Styling -->
    <KaTeXHead />

    <!-- Anti-flicker Inline Theme Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('color-theme')) {
          return localStorage.getItem('color-theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark'; // default to dark mode for sleek engineering look
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('color-theme', theme);
    </script>
  </head>

  <body class="bg-brand-light dark:bg-brand-dark text-brand-textLight dark:text-brand-textDark antialiased flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
