---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile-photo.png';

const t = useTranslations('en');

let projects: any[] = [];
try {
  projects = await getCollection('projects');
} catch (e) {
  projects = [];
}
const featuredProjects = projects.slice(0, 3);

const articles = await getCollection('blog');
const latestArticles = articles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const profileStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': new URL('/#profile', Astro.site).href,
  url: new URL('/', Astro.site).href,
  name: 'Gönül Demir | Senior Electronics R&D & Product Engineer',
  mainEntity: {
    '@type': 'Person',
    '@id': new URL('/#person', Astro.site).href,
    name: 'Gönül Demir',
    url: new URL('/', Astro.site).href,
    image: new URL(profilePhoto.src, Astro.site).href,
    jobTitle: 'Senior Electronics R&D & Product Engineer',
    description: 'Senior Electronics R&D engineer specializing in hardware design, optoelectronic sensor systems and EMC/EMI engineering.',
    sameAs: [
      'https://www.linkedin.com/in/gonul-demir-49413433/',
      'https://github.com/gonuldemir',
    ],
    knowsAbout: [
      'Electronics R&D',
      'Hardware Design',
      'Optoelectronic Sensor Systems',
      'Electromagnetic Compatibility',
      'PCB Design',
      'Product Certification',
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Istanbul',
      addressCountry: 'TR',
    },
  },
};
---

<BaseLayout
  title="Gönül Demir | Senior Electronics R&D & Product Engineer"
  structuredData={profileStructuredData}
>

  <!-- ======================================= -->
  <!-- CINEMATIC HERO SECTION                  -->
  <!-- ======================================= -->
  <section class="relative -mx-4 sm:-mx-6 lg:-mx-8 -mt-8 sm:-mt-12 px-4 sm:px-6 lg:px-8 pt-16 pb-20 sm:pt-24 sm:pb-28 overflow-hidden">
    <!-- Background gradient layers -->
    <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 dark:from-slate-950 dark:via-[#0c1222] dark:to-slate-950"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(37,99,235,0.15),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(99,102,241,0.08),transparent_50%)]"></div>

    <!-- Subtle grid pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><rect width=%2260%22 height=%2260%22 fill=%22none%22 stroke=%22white%22 stroke-width=%220.5%22/></svg>');"></div>

    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center text-center space-y-8">

      <!-- Profile Photo with Glow Ring -->
      <div class="relative group">
        <div class="absolute -inset-1.5 bg-gradient-to-tr from-blue-500 via-indigo-500 to-cyan-400 rounded-full opacity-70 blur-md group-hover:opacity-90 transition-opacity duration-500"></div>
        <div class="absolute -inset-0.5 bg-gradient-to-tr from-blue-500 via-indigo-500 to-cyan-400 rounded-full"></div>
        <Image
          src={profilePhoto}
          alt="Gönül Demir"
          width={176}
          height={176}
          class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-full object-cover object-top ring-4 ring-slate-900"
          loading="eager"
        />
        <div class="absolute bottom-2 right-2 w-5 h-5 bg-emerald-500 rounded-full border-[3px] border-slate-900 shadow-lg shadow-emerald-500/40"></div>
      </div>

      <!-- Name & Title -->
      <div class="space-y-3">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white">
          Gönül Demir
        </h1>
        <p class="text-lg sm:text-xl font-semibold bg-gradient-to-r from-blue-400 via-indigo-400 to-cyan-400 bg-clip-text text-transparent">
          Senior Electronics R&D & Product Engineer | Hardware Design | Sensor Systems | Optoelectronics | EMC/EMI
        </p>
      </div>

      <!-- Expertise Tags -->
      <div class="flex flex-wrap justify-center gap-2">
        {['Hardware Design', 'Sensor Systems', 'Optoelectronics', 'EMC/EMI'].map((tag) => (
          <span class="px-3 py-1.5 rounded-full text-xs font-medium bg-white/5 text-slate-300 border border-white/10 backdrop-blur-sm">
            {tag}
          </span>
        ))}
      </div>

      <!-- Bio paragraph -->
      <p class="max-w-2xl text-sm sm:text-base text-slate-400 leading-relaxed">
        With over 15 years of Electronics R&D expertise, I engineer high-reliability hardware architectures specializing in optoelectronic sensor design, high-speed PCB stackups, EMI/EMC noise suppression, and embedded signal processing.
      </p>

      <!-- Glassmorphism CTA Buttons -->
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <a
          href="/projects"
          class="group inline-flex items-center gap-2.5 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-semibold rounded-xl shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 transition-all duration-300 hover:scale-[1.02]"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          <span>View Projects</span>
        </a>

        <a
          href="/cv-gonul-demir-en.pdf"
          download="Gonul-Demir-CV.pdf"
          class="inline-flex items-center gap-2.5 px-5 py-3 bg-white/5 hover:bg-white/10 text-slate-200 text-sm font-medium rounded-xl border border-white/10 hover:border-white/20 backdrop-blur-md transition-all duration-300"
        >
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>{t('hero.downloadCV')}</span>
        </a>

        <a
          href="https://www.linkedin.com/in/gonul-demir-49413433/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-5 py-3 bg-white/5 hover:bg-white/10 text-white text-sm font-semibold rounded-xl border border-white/10 hover:border-white/20 backdrop-blur-md transition-all duration-300 hover:scale-[1.02]"
        >
          <svg class="w-4 h-4 text-[#0a66c2]" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
          <span>LinkedIn</span>
        </a>

        <a
          href="https://github.com/gonuldemir"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-5 py-3 bg-white/5 hover:bg-white/10 text-white text-sm font-semibold rounded-xl border border-white/10 hover:border-white/20 backdrop-blur-md transition-all duration-300 hover:scale-[1.02]"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>GitHub</span>
        </a>

        <a
          href="/contact"
          class="inline-flex items-center gap-2.5 px-5 py-3 bg-white/5 hover:bg-white/10 text-white text-sm font-semibold rounded-xl border border-white/10 hover:border-white/20 backdrop-blur-md transition-all duration-300 hover:scale-[1.02]"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          <span>Contact</span>
        </a>
      </div>

      <!-- Stats Bar -->
      <div class="flex flex-wrap justify-center gap-6 sm:gap-10 pt-4">
        <div class="text-center">
          <p class="text-2xl sm:text-3xl font-extrabold text-white">15+</p>
          <p class="text-[11px] sm:text-xs font-medium text-slate-500 uppercase tracking-wider mt-0.5">Years R&D</p>
        </div>
        <div class="w-px h-12 bg-white/10 hidden sm:block"></div>
        <div class="text-center">
          <p class="text-2xl sm:text-3xl font-extrabold text-white">50+</p>
          <p class="text-[11px] sm:text-xs font-medium text-slate-500 uppercase tracking-wider mt-0.5">Projects</p>
        </div>
        <div class="w-px h-12 bg-white/10 hidden sm:block"></div>
        <div class="text-center">
          <p class="text-2xl sm:text-3xl font-extrabold text-white">6</p>
          <p class="text-[11px] sm:text-xs font-medium text-slate-500 uppercase tracking-wider mt-0.5">Expertise Areas</p>
        </div>
      </div>
    </div>

    <!-- Bottom fade to content -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-brand-light dark:from-brand-dark to-transparent"></div>
  </section>

  {featuredProjects.length > 0 && (
    <!-- ======================================= -->
    <!-- FEATURED PROJECTS SECTION               -->
    <!-- ======================================= -->
    <section class="py-16">
      <div class="flex items-center justify-between mb-10">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-0.5 bg-brand-accent rounded-full"></div>
            <span class="text-xs font-bold uppercase tracking-widest text-brand-accent dark:text-blue-400">
              Showcase
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            {t('hero.featuredProjects')}
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Recent featured R&D hardware solutions
          </p>
        </div>

        <a
          href="/projects"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-brand-accent dark:text-blue-400 hover:underline underline-offset-4"
        >
          <span>{t('hero.viewAllProjects')}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            technologies={project.data.technologies}
            externalUrl={project.data.externalUrl}
            pubDate={project.data.pubDate}
          />
        ))}
      </div>
    </section>
  )}

  <!-- ======================================= -->
  <!-- LATEST ARTICLES SECTION                 -->
  <!-- ======================================= -->
  <section class="py-16 border-t border-slate-200 dark:border-slate-800">
    <div class="flex items-center justify-between mb-10">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <div class="w-8 h-0.5 bg-brand-accent rounded-full"></div>
          <span class="text-xs font-bold uppercase tracking-widest text-brand-accent dark:text-blue-400">
            Blog
          </span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {t('hero.latestArticles')}
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
          Technical articles in optoelectronics and EMC
        </p>
      </div>

      <a
        href="/articles"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-brand-accent dark:text-blue-400 hover:underline underline-offset-4"
      >
        <span>{t('hero.viewAllArticles')}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestArticles.map((article) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          pubDate={article.data.pubDate}
          slug={article.slug}
          category={article.data.category}
          subcategory={article.data.subcategory}
          readingTime={article.data.readingTime}
          heroImage={article.data.heroImage}
        />
      ))}
    </div>
  </section>
</BaseLayout>
