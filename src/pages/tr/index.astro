---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('tr');

// Fetch top 3 featured projects
const projects = await getCollection('projects', (p) => p.data.lang === 'tr');
const featuredProjects = projects.slice(0, 3);

// Fetch top 3 latest articles
const articles = await getCollection('blog', (a) => a.data.lang === 'tr');
const latestArticles = articles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Gönül Demir | Senior Electronics R&D & Product Engineer">
  <!-- Hero Section -->
  <section class="py-8 sm:py-16 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-brand-accent dark:text-blue-300 border border-blue-200/50 dark:border-blue-800/50">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        15+ Yıllık Elektronik Ar-Ge & Ürün Mühendisliği
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
        Gonul Demir <br/>
        <span class="text-brand-accent dark:text-blue-400 text-2xl sm:text-4xl font-bold">
          Senior Electronics R&D & Product Engineer
        </span>
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
        Hardware Design | Sensor Systems | Optoelectronics | EMC/EMI Noise Management
      </p>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        15 yılı aşkın Elektronik Ar-Ge tecrübesiyle optoelektronik sensör tasarımı, yüksek hızlı PCB layout, gürültü bastırma (EMC/EMI) ve sinyal işleme odaklı endüstriyel çözümler geliştiriyorum. Yıllarca bakım gerektirmeyen, yüksek güvenilirlikli donanım ve ürün mimarilerine odaklanıyorum.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/cv-gonul-demir-tr.pdf"
          target="_blank"
          download
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-accent hover:bg-brand-accentHover text-white text-sm font-semibold rounded-lg shadow-sm transition-all"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>{t('hero.downloadCV')}</span>
        </a>

        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 border border-slate-300 dark:border-slate-700 hover:border-brand-accent text-slate-700 dark:text-slate-200 text-sm font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4 fill-current text-[#0a66c2]" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
          <span>LinkedIn</span>
        </a>

        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 border border-slate-300 dark:border-slate-700 hover:border-brand-accent text-slate-700 dark:text-slate-200 text-sm font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>GitHub</span>
        </a>

        <a
          href="/tr/iletisim"
          class="inline-flex items-center gap-2 px-4 py-2.5 border border-slate-300 dark:border-slate-700 hover:border-brand-accent text-slate-700 dark:text-slate-200 text-sm font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          <span>E-posta</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="py-12 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          {t('hero.featuredProjects')}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Son dönemde geliştirdiğim öne çıkan Ar-Ge çözümleri
        </p>
      </div>

      <a
        href="/tr/projeler"
        class="inline-flex items-center gap-1 text-xs font-semibold text-brand-accent dark:text-blue-400 hover:underline"
      >
        <span>{t('hero.viewAllProjects')}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          technologies={project.data.technologies}
          externalUrl={project.data.externalUrl}
          pubDate={project.data.pubDate}
        />
      ))}
    </div>
  </section>

  <!-- Latest Articles Section -->
  <section class="py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          {t('hero.latestArticles')}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Optoelektronik ve EMC alanlarındaki teknik yazılarım
        </p>
      </div>

      <a
        href="/tr/makaleler"
        class="inline-flex items-center gap-1 text-xs font-semibold text-brand-accent dark:text-blue-400 hover:underline"
      >
        <span>{t('hero.viewAllArticles')}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestArticles.map((article) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          pubDate={article.data.pubDate}
          slug={article.slug}
          category={article.data.category}
          subcategory={article.data.subcategory}
          readingTime={article.data.readingTime}
        />
      ))}
    </div>
  </section>
</BaseLayout>
