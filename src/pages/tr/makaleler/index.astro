---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import SearchBar from '../../../components/SearchBar.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';

const t = useTranslations('tr');
const articles = await getCollection('blog', (a) => a.data.lang === 'tr');
const sortedArticles = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Makaleler & Ar-Ge Notları | Gönül Demir">
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
        {t('articles.title')}
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
        {t('articles.subtitle')}
      </p>
    </div>

    <!-- Search & Filter Controls -->
    <SearchBar />

    <!-- Articles Grid -->
    <div id="articles-container" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedArticles.map((article) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          pubDate={article.data.pubDate}
          slug={article.slug}
          category={article.data.category}
          subcategory={article.data.subcategory}
          readingTime={article.data.readingTime}
        />
      ))}
    </div>

    <!-- No Results Fallback Message -->
    <div id="no-results" class="hidden py-12 text-center text-slate-500 dark:text-slate-400">
      <svg class="w-12 h-12 mx-auto text-slate-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-sm font-medium">{t('articles.noResults')}</p>
    </div>
  </div>
</BaseLayout>
