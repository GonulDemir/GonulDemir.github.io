---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<BaseLayout title="About & Resume | Gönül Demir">
  <div class="max-w-4xl mx-auto space-y-12">
    <!-- Header -->
    <div class="border-b border-slate-200 dark:border-slate-800 pb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
        {t('about.title')}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        For over 15 years, I have been engineering product-driven electronics hardware, sensor systems, optoelectronics, and EMC noise management technologies.
      </p>
      
      <div class="mt-6">
        <a
          href="/cv-gonul-demir-en.pdf"
          target="_blank"
          download
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-accent hover:bg-brand-accentHover text-white text-sm font-semibold rounded-lg shadow-sm transition-all"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>Download Resume (PDF)</span>
        </a>
      </div>
    </div>

    <!-- Expertise Section -->
    <div class="space-y-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        {t('about.expertise')}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 rounded-xl p-6 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-brand-accent dark:text-blue-400 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Hardware & PCB Design</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Multi-layer HDI, high-speed differential controlled-impedance PCB design and DFM production tracking.
          </p>
        </div>

        <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 rounded-xl p-6 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-brand-accent dark:text-blue-400 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Optoelectronics & Photonics</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Laser diode drivers, APD & Photodiode transimpedance amplifiers (TIA), infrared & optical distance sensing.
          </p>
        </div>

        <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 rounded-xl p-6 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-brand-accent dark:text-blue-400 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">EMC / EMI Noise Management</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            CISPR 32 / EN 55032 compliance, shield cans, filtering, star grounding, and ESD protection.
          </p>
        </div>

        <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 rounded-xl p-6 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-brand-accent dark:text-blue-400 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Sensor Systems & Embedded DSP</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Biomedical PPG, LiDAR, precision analog front-ends (AFE), and embedded digital signal processing.
          </p>
        </div>
      </div>
    </div>

    <!-- Career Timeline Section -->
    <div class="space-y-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        {t('about.experience')}
      </h2>

      <div class="relative border-l-2 border-slate-200 dark:border-slate-800 pl-6 space-y-8">
        <!-- Timeline Item 1 -->
        <div class="relative">
          <div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-brand-accent border-4 border-white dark:border-slate-900"></div>
          <span class="text-xs font-bold text-brand-accent dark:text-blue-400">2020 - Present</span>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">Lead Electronics R&D Engineer</h3>
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Opto-Sensor & Industrial Systems</p>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
            Architected industrial LiDAR and biomedical optical sensors, managed EMC certification compliance and productization.
          </p>
        </div>

        <!-- Timeline Item 2 -->
        <div class="relative">
          <div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-slate-400 dark:bg-slate-600 border-4 border-white dark:border-slate-900"></div>
          <span class="text-xs font-bold text-slate-500 dark:text-slate-400">2015 - 2020</span>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">Senior Hardware Design Engineer</h3>
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Power Electronics & Robotics Control</p>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
            Engineered BLDC motor controller boards, EMI shielding, and high-density PCB layouts.
          </p>
        </div>

        <!-- Timeline Item 3 -->
        <div class="relative">
          <div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-slate-400 dark:bg-slate-600 border-4 border-white dark:border-slate-900"></div>
          <span class="text-xs font-bold text-slate-500 dark:text-slate-400">2011 - 2015</span>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">Electronics R&D Engineer</h3>
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Analog & Embedded Systems</p>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
            Designed microcontroller-based DAQ boards and precision analog sensor interfaces.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
