---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
const projects = await getCollection('projects', (p) => p.data.lang === 'en');
const sortedProjects = projects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="R&D Projects & Products | Gönül Demir">
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
        {t('projects.title')}
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
        {t('projects.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          technologies={project.data.technologies}
          externalUrl={project.data.externalUrl}
          pubDate={project.data.pubDate}
        />
      ))}
    </div>
  </div>
</BaseLayout>
